# Example values for a disposable local test database. Replace passwords locally.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pall_test_local
DB_USER=pall_test_user
DB_PASSWORD=replace-with-a-local-test-password
DB_ROOT_PASSWORD=replace-with-a-different-local-test-password
# DB_TLS=true enables certificate verification; use TLS for remote connections.
# APP_ORIGIN=https://your-app.example
